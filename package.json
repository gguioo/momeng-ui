{
  "name": "momeng-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "墨萌 MoMeng UI —— 宣纸、松烟墨与朱砂印里长出来的可爱 Vue 3 组件库",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "pnpm -C docs dev",
    "build": "pnpm -C packages/momeng-ui build",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,scss,md,json}\"",
    "gen": "node scripts/gen-component.mjs",
    "docs:portable": "DOCS_PORTABLE=1 pnpm -C docs build && node scripts/portable-docs.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
